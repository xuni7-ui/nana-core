{
  "$defs": {
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "subject_id": {
          "maxLength": 96,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "lineage_binding": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Lineage Binding",
          "type": "string"
        },
        "realm": {
          "$ref": "#/$defs/Realm",
          "default": "OWNED_DEVELOPMENT_ONLY"
        },
        "scope": {
          "default": "project-work",
          "maxLength": 96,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "entity_id": {
          "default": "project-user",
          "maxLength": 96,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "privacy": {
          "default": [
            "PUBLIC",
            "PROJECT"
          ],
          "items": {
            "enum": [
              "PUBLIC",
              "PROJECT",
              "PERSONAL"
            ],
            "type": "string"
          },
          "title": "Privacy",
          "type": "array"
        },
        "surface_binding_id": {
          "default": "nana.space",
          "maxLength": 96,
          "minLength": 1,
          "title": "Surface Binding Id",
          "type": "string"
        }
      },
      "required": [
        "subject_id",
        "lineage_binding"
      ],
      "title": "Binding",
      "type": "object"
    },
    "CapabilityRoute": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "COGNITION",
            "EMBED",
            "VISION",
            "IMAGE_GENERATE",
            "STT",
            "TTS",
            "AUDIO_UNDERSTAND",
            "AUDIO_GENERATE",
            "VIDEO_UNDERSTAND"
          ],
          "title": "Operation",
          "type": "string"
        },
        "primary_model_profile_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,31}\\.[a-z][a-z0-9._-]{0,95}$",
          "title": "Primary Model Profile Id",
          "type": "string"
        },
        "fallback_model_profile_ids": {
          "default": [],

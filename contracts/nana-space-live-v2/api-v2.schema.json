          "maxItems": 4,
          "minItems": 1,
          "title": "Permitted Privacy",
          "type": "array"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "operation",
        "primary_model_profile_id"
      ],
      "title": "CapabilityRoute",
      "type": "object"
    },
    "CommandRequest": {
      "additionalProperties": false,
      "properties": {
        "client_request_id": {
          "pattern": "^[A-Za-z0-9._:-]{1,96}$",
          "title": "Client Request Id",
          "type": "string"
        },
        "idempotency_key": {
          "pattern": "^[A-Za-z0-9._:-]{1,96}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "run_generation": {
          "pattern": "^[a-f0-9]{32}$",
          "title": "Run Generation",
          "type": "string"
        },
        "owner_epoch": {
          "minimum": 0,
          "title": "Owner Epoch",
          "type": "integer"
        },
        "operation": {
          "enum": [
            "PAUSE",
            "RESUME",
            "BUSY",
            "AVAILABLE",
            "REVOKE",
            "WITHDRAW",
            "SET_SURFACE"
          ],
          "title": "Operation",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enabled"
        },
        "target_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Revision"
        }
      },
      "required": [
        "client_request_id",
        "idempotency_key",
        "expected_revision",
        "run_generation",
        "owner_epoch",
        "operation"
      ],
      "title": "CommandRequest",
      "type": "object"
    },
    "Completion": {
      "enum": [
        "REQUESTED",
        "ADMITTED",
        "REJECTED",
        "RUNNING",
        "UNKNOWN",
        "VERIFIED",
        "FAILED",
        "REVOKED"

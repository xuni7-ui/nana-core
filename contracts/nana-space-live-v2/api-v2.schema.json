        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "timeout_ceiling_ms": {
          "default": 3000,
          "maximum": 30000,
          "minimum": 50,
          "title": "Timeout Ceiling Ms",
          "type": "integer"
        },
        "cost_ceiling": {
          "default": 1000,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Cost Ceiling",
          "type": "integer"

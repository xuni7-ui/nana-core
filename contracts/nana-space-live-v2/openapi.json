            "pattern": "^[a-f0-9]{32}$",
            "title": "Run Generation",
            "type": "string"
          },
          "owner_epoch": {
            "minimum": 0,
            "title": "Owner Epoch",
            "type": "integer"
          },
          "operation": {
            "enum": [
              "START",
              "STOP",
              "RESTART",
              "BACKUP",
              "UPGRADE",
              "ROLLBACK"
            ],
            "title": "Operation",
            "type": "string"
          },
          "confirmation_id": {
            "maxLength": 128,
            "minLength": 24,
            "title": "Confirmation Id",
            "type": "string"
          },
          "release_id": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Release Id"
          }
        },
        "required": [
          "client_request_id",
          "idempotency_key",
          "expected_revision",
          "run_generation",
          "owner_epoch",
          "operation",
          "confirmation_id"

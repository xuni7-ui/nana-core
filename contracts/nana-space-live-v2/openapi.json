  "components": {
    "schemas": {
      "Binding": {
        "additionalProperties": false,
        "properties": {
          "subject_id": {
            "maxLength": 96,
            "minLength": 1,
            "title": "Subject Id",
            "type": "string"
          },
          "lineage_binding": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Lineage Binding",
            "type": "string"
          },
          "realm": {
            "$ref": "#/components/schemas/Realm",
            "default": "OWNED_DEVELOPMENT_ONLY"
          },
          "scope": {
            "default": "project-work",
            "maxLength": 96,
            "minLength": 1,
            "title": "Scope",
            "type": "string"
          },
          "entity_id": {
            "default": "project-user",
            "maxLength": 96,
            "minLength": 1,
            "title": "Entity Id",
            "type": "string"
          },
          "privacy": {
            "default": [
              "PUBLIC",
              "PROJECT"
            ],
            "items": {
              "enum": [
                "PUBLIC",
                "PROJECT"
              ],
              "type": "string"
            },
            "title": "Privacy",
            "type": "array"
          },
          "surface_binding_id": {
            "default": "nana.space",
            "maxLength": 96,
            "minLength": 1,
            "title": "Surface Binding Id",
            "type": "string"
          }
        },
        "required": [
          "subject_id",
          "lineage_binding"
        ],
        "title": "Binding",
        "type": "object"
      },
      "CommandRequest": {
        "additionalProperties": false,
        "properties": {
          "client_request_id": {
            "pattern": "^[A-Za-z0-9._:-]{1,96}$",
            "title": "Client Request Id",
            "type": "string"
          },
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9._:-]{1,96}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "expected_revision": {
            "minimum": 0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "run_generation": {
            "pattern": "^[a-f0-9]{32}$",
            "title": "Run Generation",
            "type": "string"
          },
          "owner_epoch": {
            "minimum": 0,
            "title": "Owner Epoch",
            "type": "integer"
          },
          "operation": {
            "enum": [
              "PAUSE",
              "RESUME",
              "BUSY",
              "AVAILABLE",
              "REVOKE",
              "WITHDRAW",
              "SET_SURFACE"
            ],
            "title": "Operation",
            "type": "string"
          },
          "target_id": {
            "anyOf": [
              {
                "maxLength": 96,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Id"
          },
          "enabled": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Enabled"
          },
          "target_revision": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Revision"
          }
        },
        "required": [
          "client_request_id",
          "idempotency_key",
          "expected_revision",
          "run_generation",
          "owner_epoch",
          "operation"
        ],
        "title": "CommandRequest",
        "type": "object"
      },
      "Completion": {
        "enum": [
          "REQUESTED",
          "ADMITTED",
          "REJECTED",
          "RUNNING",
          "UNKNOWN",
          "VERIFIED",
          "FAILED",
          "REVOKED"
        ],
        "title": "Completion",
        "type": "string"
      },
      "Envelope": {
        "additionalProperties": false,
        "properties": {
          "contract": {
            "const": "nana-space-live/v2",
            "default": "nana-space-live/v2",
            "title": "Contract",
            "type": "string"
          },
          "realm": {
            "$ref": "#/components/schemas/Realm"
          },
          "subject_id": {
            "title": "Subject Id",
            "type": "string"
          },
          "lineage_binding": {
            "title": "Lineage Binding",
            "type": "string"
          },
          "owner_epoch": {
            "minimum": 0,
            "title": "Owner Epoch",
            "type": "integer"
          },
          "run_generation": {
            "pattern": "^[a-f0-9]{32}$",
            "title": "Run Generation",
            "type": "string"
          },
          "session_generation": {
            "minimum": 1,
            "title": "Session Generation",
            "type": "integer"
          },
          "as_of_us": {
            "minimum": 0,
            "title": "As Of Us",
            "type": "integer"
          },
          "revision": {
            "minimum": 0,
            "title": "Revision",
            "type": "integer"
          },
          "coverage": {
            "enum": [
              "CURRENT",
              "NO_DATA",
              "BLOCKED_SCOPE",
              "UNKNOWN",
              "UNAVAILABLE",
              "STALE"
            ],
            "title": "Coverage",
            "type": "string"
          },
          "privacy_scope": {
            "items": {
              "enum": [
                "PUBLIC",
                "PROJECT"
              ],
              "type": "string"
            },
            "title": "Privacy Scope",
            "type": "array"
          },
          "source_refs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Source Refs",
            "type": "array"
          },
          "capabilities": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                }
              ]
            },
            "title": "Capabilities",
            "type": "object"
          },
          "execution_authority": {
            "const": false,
            "default": false,
            "title": "Execution Authority",
            "type": "boolean"
          },
          "data": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Data",
            "type": "object"
          }
        },
        "required": [
          "realm",
          "subject_id",
          "lineage_binding",
          "owner_epoch",
          "run_generation",
          "session_generation",
          "as_of_us",
          "revision",
          "coverage",
          "privacy_scope",
          "capabilities",
          "data"
        ],
        "title": "Envelope",
        "type": "object"
      },
      "HostConfirmation": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "enum": [
              "START",
              "STOP",
              "RESTART",
              "BACKUP",
              "UPGRADE",
              "ROLLBACK"
            ],
            "title": "Operation",
            "type": "string"
          },
          "expected_revision": {
            "minimum": 0,
            "title": "Expected Revision",
            "type": "integer"
          },
          "release_id": {
            "anyOf": [
              {
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Release Id"
          }
        },
        "required": [
          "operation",
          "expected_revision"
        ],
        "title": "HostConfirmation",
        "type": "object"
      },
      "HostRequest": {
        "additionalProperties": false,
        "properties": {
          "client_request_id": {
            "pattern": "^[A-Za-z0-9._:-]{1,96}$",
            "title": "Client Request Id",
            "type": "string"
          },
          "idempotency_key": {
            "pattern": "^[A-Za-z0-9._:-]{1,96}$",
            "title": "Idempotency Key",

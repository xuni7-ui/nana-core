+
+def _resolve_inject_max_chars(config, msg_count: int) -> int:
+    """P0-B：按 context budget 动态计算「单条消息注入字符上限」。
+
+    旧实现固定 300 字符，长消息被拦腰砍断、信息损失大。
+    新实现把 L1 注入总量切成「总字符预算 / 条数」，再夹在
+    [单条下限, 单条硬上限] 之间：消息多则单条少、消息少则单条多。
+
+    回退开关：l1_inject_budget_chars <= 0 时，退回固定单条上限。
+    """
+    hard_cap = cast(int, config.get("l1_inject_max_content_chars", 300))
+    budget = cast(int, config.get("l1_inject_budget_chars", 0))
+    if budget <= 0 or msg_count <= 0:
+        return hard_cap
+    floor = cast(int, config.get("l1_inject_min_content_chars", 0))
+    per_msg = budget // msg_count
+    # 预算硬约束：保证 msg_count * per_msg <= budget。
+    # 下限 floor 只在「抬到 floor 后总量仍 <= budget」时才兜底，否则让位给预算。
+    if floor > 0 and per_msg < floor and floor * msg_count <= budget:
+        per_msg = floor
+    if hard_cap > 0:
+        per_msg = min(per_msg, hard_cap)
+    # 保底 1：避免 per_msg=0 被上层当成「0=不截断」而全量注入，反破预算。
+    if per_msg < 1:
+        per_msg = 1
+    return per_msg

+def _max_prefix_len(text: str, token_budget: int) -> int:
+    """二分求「前缀 token 数 <= token_budget」的最大字符长度。"""
+    if token_budget <= 0:
+        return 0
+    lo, hi = 0, len(text)
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if count_tokens(text[:mid]) <= token_budget:
+            lo = mid
+        else:
+            hi = mid - 1
+    return lo
+
+
+def _max_suffix_len(text: str, token_budget: int) -> int:
+    """二分求「后缀 token 数 <= token_budget」的最大字符长度。"""
+    if token_budget <= 0:
+        return 0
+    lo, hi = 0, len(text)
+    while lo < hi:
+        mid = (lo + hi + 1) // 2
+        if count_tokens(text[len(text) - mid:]) <= token_budget:
+            lo = mid
+        else:
+            hi = mid - 1
+    return lo
+
+
+def _compress_oversize(text: str, token_budget: int) -> str:
+    """把超长文本压缩进 token_budget：保留头 + 尾，中间插标记。
+
+    - 与 token 计数口径无关（二分实测），tiktoken 缺失降级时同样成立。
+    - 尾部通常是结论/最新内容，故头尾都保留，中间丢弃。
+    - 极端情况退化为「极短头部 + 标记」，绝不返回空串。
+    """
+    if token_budget <= 0 or count_tokens(text) <= token_budget:
+        return text
+
+    mark_tokens = count_tokens(_OVERSIZE_MARK)
+    room = max(1, token_budget - mark_tokens)
+
+    head_budget = max(1, int(room * _OVERSIZE_HEAD_RATIO))
+    tail_budget = max(0, room - head_budget)
+
+    n_head = _max_prefix_len(text, head_budget)
+    rest = text[n_head:]
+    n_tail = _max_suffix_len(rest, tail_budget) if tail_budget > 0 else 0
+    tail_part = rest[len(rest) - n_tail:] if n_tail > 0 else ""
+
+    result = text[:n_head] + _OVERSIZE_MARK + tail_part
+
+    # 收尾校准：分词边界可能让拼接结果略超预算，循环微调头部
+    guard = 0
+    while count_tokens(result) > token_budget and n_head > 0 and guard < 64:
+        n_head = int(n_head * 0.9)
+        rest = text[n_head:]
+        n_tail = _max_suffix_len(rest, tail_budget) if tail_budget > 0 else 0
+        tail_part = rest[len(rest) - n_tail:] if n_tail > 0 else ""
+        result = text[:n_head] + _OVERSIZE_MARK + tail_part
+        guard += 1
+    return result or _OVERSIZE_MARK
+

+_WAKE_NOISE_RE = re.compile(r"\[At:[^\]]*\]")
+_PUNCT_ONLY_RE = re.compile(
+    r"[\s，。！？!?~～,.;；:：、…—\-—_\"'“”‘’（）()\[\]【】<>《》]+"

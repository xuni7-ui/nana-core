+def _clean_short_text(text: str) -> str:
+    """洗掉 @占位符与标点，只留实词，用于判断是不是「孤词」。"""
+    if not text:
+        return ""
+    cleaned = _WAKE_NOISE_RE.sub("", text)
+    cleaned = _PUNCT_ONLY_RE.sub("", cleaned)
+    return cleaned.strip()
+
+
+def _is_lone_token(text: str, max_chars: int) -> bool:
+    """判断是否为孤词/唤醒词（清洗后长度不超过阈值）。"""
+    cleaned = _clean_short_text(text)
+    if not cleaned:
+        return True
+    return len(cleaned) <= max(1, max_chars)

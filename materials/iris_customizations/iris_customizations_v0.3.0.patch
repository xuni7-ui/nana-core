+def _format_memory_time_tag(entry: object) -> str:
+    """给一条 L2 记忆钉上时间前缀：[MM-DD HH:MM · N天前]
+
+    时间口径说明：落库时间戳是写入时的「本地时钟」（容器多为 UTC），
+    展示时统一换算成北京时间（UTC+8）。补差是动态算的：
+    shift = 8h - 本地相对 UTC 的偏移，所以将来容器时区改成 CST，
+    也不会重复叠加 8 小时。没有时间戳时老实写 [时间未知]，
+    绝不用当前时间冒充。
+    """
+    raw = getattr(entry, "timestamp", None)
+    if not raw:
+        return "[时间未知] "
+    try:
+        dt = datetime.fromisoformat(str(raw))
+    except Exception:
+        return f"[{str(raw)[:16]}] "
+    if dt.tzinfo is not None:
+        dt = dt.astimezone().replace(tzinfo=None)
+
+    try:
+        import time as _time
+
+        shift = 8 * 3600 - int(_time.localtime().tm_gmtoff)
+    except Exception:
+        shift = 0
+
+    shown = dt + timedelta(seconds=shift)
+    now_shown = datetime.now() + timedelta(seconds=shift)
+    delta_days = (now_shown.date() - shown.date()).days
+    if delta_days <= 0:
+        age = "今天"
+    elif delta_days == 1:
+        age = "昨天"
+    else:
+        age = f"{delta_days}天前"
+    return f"[{shown.strftime('%m-%d %H:%M')} · {age}] "
+

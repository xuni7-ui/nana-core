+# ============================================================================
+# P0-B：超长消息「保底压缩」——杜绝整条静默丢弃
+# ============================================================================
+
+_OVERSIZE_MARK: str = " …〔原文超长·已压缩〕… "
+_OVERSIZE_HEAD_RATIO: float = 0.6   # 压缩后头部预算占比
+_OVERSIZE_TAIL_RATIO: float = 0.4   # 压缩后尾部预算占比
